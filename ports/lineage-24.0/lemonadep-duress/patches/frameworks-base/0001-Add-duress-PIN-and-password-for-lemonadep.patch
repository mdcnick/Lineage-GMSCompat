+    @Override
+    public void setDuressCredentials(LockscreenCredential ownerCredential,
+            LockscreenCredential pin, LockscreenCredential password) {
+        try {
+            enforceDuressManagementPermission();
+            final long identity = Binder.clearCallingIdentity();
+            try {
+                final long protectorId = verifyDuressOwner(ownerCredential);
+                synchronized (mSpManager) {
+                    enforceDuressOwnerProtector(protectorId);
+                    mDuressPasswordHelper.setDuressCredentials(pin, password);
+                }
+            } finally {
+                Binder.restoreCallingIdentity(identity);
+            }
+        } finally {
+            LockscreenCredential.zeroizeIfFromParcel(ownerCredential);
+            LockscreenCredential.zeroizeIfFromParcel(pin);
+            LockscreenCredential.zeroizeIfFromParcel(password);
+        }
+    }
+
+    @Override
+    public boolean hasDuressCredentials(LockscreenCredential ownerCredential) {
+        try {
+            enforceDuressManagementPermission();
+            final long identity = Binder.clearCallingIdentity();
+            try {
+                final long protectorId = verifyDuressOwner(ownerCredential);
+                synchronized (mSpManager) {
+                    enforceDuressOwnerProtector(protectorId);
+                    return mDuressPasswordHelper.hasDuressCredentials();
+                }
+            } finally {
+                Binder.restoreCallingIdentity(identity);
+            }
