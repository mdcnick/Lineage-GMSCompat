+/*
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.android.server.locksettings;
+
+import com.android.internal.annotations.VisibleForTesting;
+import com.android.server.power.PowerManagerService;
+import com.android.server.recoverysystem.RecoverySystemService;
+
+final class DuressWipe {
+    static void run() {
+        run(RecoverySystemService::deleteSecrets, () -> PowerManagerService.lowLevelShutdown(null));
+    }
+
+    @VisibleForTesting
+    static void run(Runnable deleteSecrets, Runnable shutdown) {
+        try {
+            // Delete KeyMint keys (including storage-encryption keys) and Secretkeeper secrets.
+            deleteSecrets.run();
+        } finally {
+            shutdown.run();
+        }
+    }
+}
