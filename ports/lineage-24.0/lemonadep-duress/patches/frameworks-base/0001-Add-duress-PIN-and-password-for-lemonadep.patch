+    public static List<PasswordValidationError> validateDuressCredential(
+            @NonNull LockscreenCredential credential) {
+        if (!credential.isPin() && !credential.isPassword()) {
+            throw new IllegalArgumentException("Duress credential must be a PIN or password");
+        }
+        var metrics = new PasswordMetrics(credential.getType());
+        metrics.length = 4;
+        return PasswordMetrics.validateCredential(
+                metrics, DevicePolicyManager.PASSWORD_COMPLEXITY_LOW, credential);
+    }
+
+    public void setDuressCredentials(@NonNull LockscreenCredential ownerCredential,
+            @NonNull LockscreenCredential duressPin, @NonNull LockscreenCredential duressPassword) {
+        try {
+            getLockSettings().setDuressCredentials(ownerCredential, duressPin, duressPassword);
+        } catch (RemoteException e) {
+            throw e.rethrowFromSystemServer();
+        }
+    }
+
+    public void deleteDuressCredentials(@NonNull LockscreenCredential ownerCredential) {
+        try (var noCredential = LockscreenCredential.createNone()) {
+            setDuressCredentials(ownerCredential, noCredential, noCredential);
+        }
+    }
+
+    public boolean hasDuressCredentials(@NonNull LockscreenCredential ownerCredential) {
+        try {
+            return getLockSettings().hasDuressCredentials(ownerCredential);
+        } catch (RemoteException e) {
+            throw e.rethrowFromSystemServer();
+        }
+    }
 }
diff --git a/services/core/java/com/android/server/locksettings/DuressCredential.java b/services/core/java/com/android/server/locksettings/DuressCredential.java
new file mode 100644
index 00000000..f617d0ad
--- /dev/null
+++ b/services/core/java/com/android/server/locksettings/DuressCredential.java
@@ -0,0 +1,103 @@
+/*
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.android.server.locksettings;
+
+import com.android.internal.util.ArrayUtils;
+import com.android.internal.widget.LockPatternUtils;
+import com.android.internal.widget.LockscreenCredential;
+import com.android.internal.widget.PasswordValidationError;
+import com.android.server.locksettings.SyntheticPasswordManager.PasswordData;
+
+import java.io.DataInputStream;
+import java.io.DataOutputStream;
+import java.io.IOException;
+import java.nio.ByteBuffer;
+import java.security.MessageDigest;
+import java.util.Arrays;
+import java.util.List;
+
+class DuressCredential {
+    private final PasswordData salt;
+    private final byte[] hashedCredential;
+
+    DuressCredential(PasswordData salt, byte[] hashedCredential) {
+        this.salt = salt;
+        this.hashedCredential = hashedCredential;
+    }
+
+    static DuressCredential create(LockscreenCredential credential, SyntheticPasswordManager spm) {
+        PasswordData salt = PasswordData.create(credential.getType(),
+                // no need to leak PIN length here, it's used only for PIN auto-confirm
+                LockPatternUtils.PIN_LENGTH_UNAVAILABLE);
+        byte[] hashedCredential = spm.stretchLskf(credential, salt);
+        return new DuressCredential(salt, hashedCredential);
+    }
+
+    boolean verify(SyntheticPasswordManager spm, LockscreenCredential credential) {
+        byte[] candidate = spm.stretchLskf(credential, salt);
+        try {
+            return MessageDigest.isEqual(hashedCredential, candidate);
+        } finally {
+            ArrayUtils.zeroize(candidate);
+        }
+    }
+
+    int getType() {
+        return salt.credentialType;
+    }
+
+    void serialize(DataOutputStream s) throws IOException {
+        byte[] saltBytes = salt.toBytes();
+        s.writeInt(saltBytes.length);
+        s.write(saltBytes);
+        s.writeInt(hashedCredential.length);
+        s.write(hashedCredential);
+    }
+
+    static DuressCredential deserialize(DataInputStream s) throws IOException {
+        byte[] saltBytes = readField(s);
+        // PasswordData is type, three scrypt costs, salt length and bytes, handle length,
+        // and an optional PIN length. Duress records never contain a Gatekeeper handle.
+        ByteBuffer data = ByteBuffer.wrap(saltBytes);
+        data.getInt();
+        int logN = data.get();
+        int logR = data.get();
+        int logP = data.get();
+        int saltLength = data.getInt();
+        if (logN < 1 || logR < 0 || logN + logR > 17 || logP < 0 || logP > 3
+                || saltLength <= 0 || saltLength > data.remaining() - Integer.BYTES) {
+            throw new IOException("Invalid duress credential salt");
+        }
+        data.position(data.position() + saltLength);
+        if (data.getInt() != 0 || (data.hasRemaining() && data.remaining() != Integer.BYTES)) {
+            throw new IOException("Invalid duress password metadata");
+        }
+        return new DuressCredential(PasswordData.fromBytes(saltBytes), readField(s));
+    }
+
+    private static byte[] readField(DataInputStream s) throws IOException {
+        int length = s.readInt();
+        if (length <= 0 || length > s.available()) {
+            throw new IOException("Invalid duress credential field length");
+        }
+        byte[] bytes = new byte[length];
+        s.readFully(bytes);
+        return bytes;
+    }
+
+    static void validate(LockscreenCredential credential, int expectedType) {
+        int type = credential.getType();
+        if (type != expectedType) {
+            throw new IllegalArgumentException("type mismatch: expected " + expectedType + ", got " + type);
+        }
+
+        List<PasswordValidationError> validationErrors =
+                LockPatternUtils.validateDuressCredential(credential);
+        if (!validationErrors.isEmpty()) {
+            throw new IllegalArgumentException("validation failed: " +
+                    Arrays.toString(validationErrors.toArray()));
+        }
+    }
+}
diff --git a/services/core/java/com/android/server/locksettings/DuressCredentials.java b/services/core/java/com/android/server/locksettings/DuressCredentials.java
new file mode 100644
index 00000000..691c406a
--- /dev/null
+++ b/services/core/java/com/android/server/locksettings/DuressCredentials.java
@@ -0,0 +1,106 @@
+/*
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.android.server.locksettings;
+
+import android.annotation.Nullable;
+import android.os.UserHandle;
+
+import com.android.internal.widget.LockscreenCredential;
+
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.DataInputStream;
+import java.io.DataOutputStream;
+import java.io.IOException;
+
+import libcore.util.HexEncoding;
+
+import static com.android.internal.widget.LockPatternUtils.CREDENTIAL_TYPE_PASSWORD;
+import static com.android.internal.widget.LockPatternUtils.CREDENTIAL_TYPE_PIN;
+
+class DuressCredentials {
+    final DuressCredential pin;
+    final DuressCredential password;
+
+    DuressCredentials(DuressCredential pin, DuressCredential password) {
+        if (pin.getType() != CREDENTIAL_TYPE_PIN) {
+            throw new IllegalArgumentException();
+        }
+        this.pin = pin;
+        if (password.getType() != CREDENTIAL_TYPE_PASSWORD) {
+            throw new IllegalArgumentException();
+        }
+        this.password = password;
+    }
+
+    static DuressCredentials create(SyntheticPasswordManager spm,
+                                    LockscreenCredential pin, LockscreenCredential password) {
+        return new DuressCredentials(DuressCredential.create(pin, spm),
+                DuressCredential.create(password, spm));
+    }
+
+    static final String LOCK_SETTINGS_STORAGE_KEY = "duress_credentials";
+    private static final int LOCK_SETTINGS_STORAGE_USER_ID = UserHandle.USER_SYSTEM;
+
+    void save(LockSettingsStorage lss) {
+        lss.setString(LOCK_SETTINGS_STORAGE_KEY, serialize(), LOCK_SETTINGS_STORAGE_USER_ID);
+    }
+
+    @Nullable
+    static String readStored(LockSettingsStorage lss) {
+        return lss.getString(LOCK_SETTINGS_STORAGE_KEY, null, LOCK_SETTINGS_STORAGE_USER_ID);
+    }
+
+    static void delete(LockSettingsStorage lss) {
+        lss.removeKey(LOCK_SETTINGS_STORAGE_KEY, LOCK_SETTINGS_STORAGE_USER_ID);
+    }
+
+    DuressCredential get(int type) {
+        return switch (type) {
+            case CREDENTIAL_TYPE_PIN -> pin;
+            case CREDENTIAL_TYPE_PASSWORD -> password;
+            default -> throw new IllegalArgumentException(Integer.toString(type));
+        };
+    }
+
+    private static final int VERSION = 0;
+    private static final int MAX_ENCODED_LENGTH = 512;
+
+    private String serialize() {
+        var bos = new ByteArrayOutputStream(1000);
+        var s = new DataOutputStream(bos);
+        try {
+            s.writeByte(VERSION);
+            pin.serialize(s);
+            password.serialize(s);
+        } catch (IOException e) {
+            // ByteArrayOutputStream never throws IOException
+            throw new IllegalStateException(e);
+        }
+
+        return HexEncoding.encodeToString(bos.toByteArray());
+    }
+
+    static DuressCredentials deserialize(String str) {
+        if (str.length() > MAX_ENCODED_LENGTH) {
+            throw new IllegalArgumentException("Oversized duress credential record");
+        }
+        var s = new DataInputStream(new ByteArrayInputStream(HexEncoding.decode(str)));
+        try {
+            int version = s.readUnsignedByte();
+            if (version != VERSION) {
+                throw new IllegalArgumentException("Unknown duress credential format");
+            }
+            var pin = DuressCredential.deserialize(s);
+            var password = DuressCredential.deserialize(s);
+            if (s.available() != 0) {
+                throw new IllegalArgumentException("Trailing duress credential data");
+            }
+            return new DuressCredentials(pin, password);
+        } catch (IOException e) {
+            throw new IllegalArgumentException("Could not read duress credentials", e);
+        }
+    }
+}
diff --git a/services/core/java/com/android/server/locksettings/DuressPasswordHelper.java b/services/core/java/com/android/server/locksettings/DuressPasswordHelper.java
new file mode 100644
index 00000000..2a5c1748
--- /dev/null
+++ b/services/core/java/com/android/server/locksettings/DuressPasswordHelper.java
@@ -0,0 +1,132 @@
+/*
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.android.server.locksettings;
+
+import android.os.Handler;
+import android.os.HandlerThread;
+import android.util.Slog;
+
+import com.android.internal.annotations.GuardedBy;
+import com.android.internal.annotations.VisibleForTesting;
+import com.android.internal.widget.LockscreenCredential;
+
+import java.util.Objects;
+import java.util.function.BooleanSupplier;
+
+import static com.android.internal.widget.LockPatternUtils.CREDENTIAL_TYPE_PASSWORD;
+import static com.android.internal.widget.LockPatternUtils.CREDENTIAL_TYPE_PIN;
+
+class DuressPasswordHelper {
+    private static final String TAG = "DuressPasswordHelper";
+
+    private final LockSettingsStorage mStorage;
+    private final SyntheticPasswordManager mSpManager;
+    private final Handler mHandler;
+    private final Runnable mWipe;
+
+    @GuardedBy("mSpManager")
+    private boolean mWipeStarted;
+
+    DuressPasswordHelper(LockSettingsStorage storage, SyntheticPasswordManager spManager) {
+        this(storage, spManager, startVerificationThread(), DuressWipe::run);
+    }
+
+    @VisibleForTesting
+    DuressPasswordHelper(LockSettingsStorage storage, SyntheticPasswordManager spManager,
+            Handler handler, Runnable wipe) {
+        mStorage = storage;
+        mSpManager = spManager;
+        mHandler = handler;
+        mWipe = wipe;
+    }
+
+    private static Handler startVerificationThread() {
+        var thread = new HandlerThread("DuressCredentialVerification");
+        thread.start();
+        return thread.getThreadHandler();
+    }
+
+    @GuardedBy("mSpManager")
+    void onCredentialRejected(LockscreenCredential credential, BooleanSupplier protectorIsCurrent) {
+        if (mWipeStarted || (!credential.isPin() && !credential.isPassword())
+                || credential.isUnifiedProfilePassword()) {
+            return;
+        }
+        try {
+            String enrolled = DuressCredentials.readStored(mStorage);
+            if (enrolled == null) {
+                return;
+            }
+
+            // The service or caller will zeroize the original after returning.
+            LockscreenCredential copy = credential.duplicate();
+            boolean posted = false;
+            try {
+                posted = mHandler.post(() -> verifyAndWipe(copy, enrolled, protectorIsCurrent));
+            } finally {
+                if (!posted) {
+                    copy.zeroize();
+                }
+            }
+        } catch (RuntimeException e) {
+            Slog.e(TAG, "Could not queue duress credential verification");
+        }
+    }
+
+    private void verifyAndWipe(LockscreenCredential credential, String enrolled,
+            BooleanSupplier protectorIsCurrent) {
+        try {
+            try (credential) {
+                if (!DuressCredentials.deserialize(enrolled).get(credential.getType())
+                        .verify(mSpManager, credential)) {
+                    return;
+                }
+            }
+
+            synchronized (mSpManager) {
+                // A deletion/re-enrollment or a protector change cancels a queued match.
+                if (mWipeStarted || !enrolled.equals(DuressCredentials.readStored(mStorage))
+                        || !protectorIsCurrent.getAsBoolean()) {
+                    return;
+                }
+                mWipeStarted = true;
+            }
+        } catch (RuntimeException e) {
+            Slog.e(TAG, "Could not verify duress credential");
+            return;
+        }
+        mWipe.run();
+    }
+
+    @GuardedBy("mSpManager")
+    void setDuressCredentials(LockscreenCredential pin, LockscreenCredential password) {
+        Objects.requireNonNull(pin, "pin");
+        Objects.requireNonNull(password, "password");
+
+        if (mWipeStarted) {
+            throw new IllegalStateException("Duress shutdown already initiated");
+        }
+        if (pin.isNone() && password.isNone()) {
+            deleteDuressCredentials();
+            return;
+        }
+
+        DuressCredential.validate(pin, CREDENTIAL_TYPE_PIN);
+        DuressCredential.validate(password, CREDENTIAL_TYPE_PASSWORD);
+        DuressCredentials.create(mSpManager, pin, password).save(mStorage);
+    }
+
+    @GuardedBy("mSpManager")
+    boolean hasDuressCredentials() {
+        return DuressCredentials.readStored(mStorage) != null;
+    }
+
+    @GuardedBy("mSpManager")
+    void deleteDuressCredentials() {
+        if (hasDuressCredentials()) {
+            DuressCredentials.delete(mStorage);
+        }
+    }
+}
