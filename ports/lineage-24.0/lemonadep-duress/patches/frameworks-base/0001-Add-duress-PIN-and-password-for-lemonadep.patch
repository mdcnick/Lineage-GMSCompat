+
+    private long verifyDuressOwner(LockscreenCredential ownerCredential) {
+        if (ownerCredential == null || ownerCredential.isNone()) {
+            throw new SecurityException("An existing owner credential is required");
+        }
+        final int owner = UserHandle.USER_SYSTEM;
+        // Recheck the protector under the SP lock before using the verification result.
+        final long protectorId = getCurrentLskfBasedProtectorId(owner);
+        if (!doVerifyCredential(ownerCredential, owner, null, 0 /* flags */).isMatched()) {
+            throw new SecurityException("Owner credential verification failed");
+        }
+        return protectorId;
+    }
+
+    @GuardedBy("mSpManager")
+    private void enforceDuressOwnerProtector(long protectorId) {
+        if (protectorId != getCurrentLskfBasedProtectorId(UserHandle.USER_SYSTEM)) {
+            throw new SecurityException("Owner credential changed during verification");
+        }
+    }
