+/*
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.android.server.locksettings;
+
+import static android.os.UserHandle.USER_SYSTEM;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertNull;
+import static org.junit.Assert.assertTrue;
+import static org.mockito.ArgumentMatchers.anyString;
+import static org.mockito.ArgumentMatchers.eq;
+import static org.mockito.ArgumentMatchers.isNull;
+import static org.mockito.Mockito.doAnswer;
+import static org.mockito.Mockito.doThrow;
+import static org.mockito.Mockito.inOrder;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.never;
+import static org.mockito.Mockito.verify;
+import static org.testng.Assert.assertThrows;
+import static org.mockito.Mockito.when;
+
+import android.os.Handler;
+import android.os.test.TestLooper;
+
+import androidx.test.filters.SmallTest;
+import androidx.test.runner.AndroidJUnit4;
+
+import com.android.internal.widget.LockscreenCredential;
+
+import org.junit.Before;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+
+import java.util.concurrent.atomic.AtomicReference;
+
+/** atest FrameworksServicesTests:DuressPasswordHelperTest */
+@SmallTest
+@RunWith(AndroidJUnit4.class)
+public class DuressPasswordHelperTest {
+    private static final String STORAGE_KEY = DuressCredentials.LOCK_SETTINGS_STORAGE_KEY;
+
+    private final AtomicReference<String> mRecord = new AtomicReference<>();
+    private final LockSettingsStorage mStorage = mock(LockSettingsStorage.class);
+    private final SyntheticPasswordManager mSpManager =
+            new SyntheticPasswordManager(null, mStorage, null, null, null);
+    private final TestLooper mLooper = new TestLooper();
+    private final Runnable mWipe = mock(Runnable.class);
+    private final DuressPasswordHelper mHelper =
+            new DuressPasswordHelper(mStorage, mSpManager, new Handler(mLooper.getLooper()), mWipe);
+
+    @Before
+    public void setUp() {
+        when(mStorage.getString(eq(STORAGE_KEY), isNull(), eq(USER_SYSTEM)))
+                .thenAnswer(invocation -> mRecord.get());
+        doAnswer(invocation -> {
+            mRecord.set(invocation.getArgument(1));
+            return null;
+        }).when(mStorage).setString(eq(STORAGE_KEY), anyString(), eq(USER_SYSTEM));
+        doAnswer(invocation -> {
+            mRecord.set(null);
+            return null;
+        }).when(mStorage).removeKey(STORAGE_KEY, USER_SYSTEM);
+    }
+
+    @Test
+    public void rejectedNonMatchesDoNotWipe() {
+        enroll();
+        tryRejected(LockscreenCredential.createPin("8429"));
+        tryRejected(LockscreenCredential.createPassword("2591")); // PIN bytes, password type
+        tryRejected(LockscreenCredential.createPassword("wrong-password"));
+        mLooper.dispatchAll();
+        verify(mWipe, never()).run();
+    }
+
+    @Test
+    public void rejectedPinMatchWipesOnceAfterCallerZeroizesOriginal() {
+        enroll();
+        tryRejected(LockscreenCredential.createPin("2591"));
+        tryRejected(LockscreenCredential.createPin("2591"));
+        mLooper.dispatchAll();
+        verify(mWipe).run();
+    }
+
+    @Test
+    public void rejectedPasswordMatchWipes() {
+        enroll();
+        tryRejected(LockscreenCredential.createPassword("test-duress-password"));
+        mLooper.dispatchAll();
+        verify(mWipe).run();
+    }
+
+    @Test
+    public void deletionCancelsQueuedMatch() {
+        enroll();
+        tryRejected(LockscreenCredential.createPin("2591"));
+        try (var none = LockscreenCredential.createNone()) {
+            synchronized (mSpManager) {
+                mHelper.setDuressCredentials(none, none);
+                assertFalse(mHelper.hasDuressCredentials());
+            }
+        }
+        assertNull(mRecord.get());
+        tryRejected(LockscreenCredential.createPassword("test-duress-password"));
+        mLooper.dispatchAll();
+        verify(mWipe, never()).run();
+    }
+
+    @Test
+    public void credentialChangeCancelsQueuedMatch() {
+        enroll();
+        try (var pin = LockscreenCredential.createPin("2591")) {
+            synchronized (mSpManager) {
+                mHelper.onCredentialRejected(pin, () -> false);
+            }
+        }
+        mLooper.dispatchAll();
+        verify(mWipe, never()).run();
+    }
+
+    @Test
+    public void invalidEnrollmentLeavesExistingRecordIntact() {
+        enroll();
+        String before = mRecord.get();
+        try (var tooShort = LockscreenCredential.createPin("19");
+                var wrongType = LockscreenCredential.createPassword("2591");
+                var password = LockscreenCredential.createPassword("test-duress-password");
+                var none = LockscreenCredential.createNone()) {
+            synchronized (mSpManager) {
+                assertThrows(IllegalArgumentException.class,
+                        () -> mHelper.setDuressCredentials(tooShort, password));
+                assertThrows(IllegalArgumentException.class,
+                        () -> mHelper.setDuressCredentials(wrongType, password));
+                assertThrows(IllegalArgumentException.class,
+                        () -> mHelper.setDuressCredentials(none, password));
+            }
+        }
+        assertEquals(before, mRecord.get());
+    }
+
+    @Test
+    public void wipeDeletesSecretsBeforeShutdown() {
+        Runnable delete = mock(Runnable.class);
+        Runnable shutdown = mock(Runnable.class);
+        DuressWipe.run(delete, shutdown);
+        var order = inOrder(delete, shutdown);
+        order.verify(delete).run();
+        order.verify(shutdown).run();
+    }
+
+    @Test
+    public void wipeShutsDownIfSecretDeletionThrows() {
+        Runnable delete = mock(Runnable.class);
+        Runnable shutdown = mock(Runnable.class);
+        doThrow(new IllegalStateException()).when(delete).run();
+        assertThrows(IllegalStateException.class, () -> DuressWipe.run(delete, shutdown));
+        verify(shutdown).run();
+    }
+
+    private void enroll() {
+        try (var pin = LockscreenCredential.createPin("2591");
+                var password = LockscreenCredential.createPassword("test-duress-password")) {
+            synchronized (mSpManager) {
+                mHelper.setDuressCredentials(pin, password);
+                assertTrue(mHelper.hasDuressCredentials());
+            }
+        }
+    }
+
+    private void tryRejected(LockscreenCredential credential) {
+        try (credential) {
+            synchronized (mSpManager) {
+                mHelper.onCredentialRejected(credential, () -> true);
+            }
+        }
+    }
+}
