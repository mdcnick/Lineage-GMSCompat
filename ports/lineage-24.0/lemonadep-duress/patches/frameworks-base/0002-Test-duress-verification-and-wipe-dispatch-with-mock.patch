         mService.initializeSyntheticPassword(MANAGED_PROFILE_USER_ID);
     }
 
+    @Test
+    public void duressIsCheckedOnlyAfterWeaverRejectsCredential() throws Exception {
+        mSpManager.enableWeaver();
+        try (var real = newPin("5962"); var candidate = newPin("2591")) {
+            setCredential(PRIMARY_USER_ID, real);
+            assertTrue(mService.checkCredential(real, PRIMARY_USER_ID, null).isMatched());
+            verify(mInjector.mDuressPasswordHelper, never()).onCredentialRejected(any(), any());
+
+            mSpManager.injectWeaverReadResponse(WeaverReadStatus.INCORRECT_KEY, Duration.ZERO);
+            assertFalse(mService.verifyCredential(candidate, PRIMARY_USER_ID, 0).isMatched());
+            verify(mInjector.mDuressPasswordHelper).onCredentialRejected(eq(candidate), any());
+        }
+    }
+
+    @Test
+    public void duressIsCheckedAfterGatekeeperRejectsCredential() throws Exception {
+        try (var real = newPassword("normal-screen-lock");
+                var candidate = newPassword("test-duress-password")) {
+            setCredential(PRIMARY_USER_ID, real);
+            assertTrue(mService.verifyCredential(real, PRIMARY_USER_ID, 0).isMatched());
+            verify(mInjector.mDuressPasswordHelper, never()).onCredentialRejected(any(), any());
+
+            assertFalse(mService.checkCredential(candidate, PRIMARY_USER_ID, null).isMatched());
+            verify(mInjector.mDuressPasswordHelper).onCredentialRejected(eq(candidate), any());
+        }
+    }
+
+    @Test
+    public void duressIsSkippedWhenWeaverThrottlesOrErrors() throws Exception {
+        mSpManager.enableWeaver();
+        try (var real = newPin("5962"); var candidate = newPin("2591")) {
+            setCredential(PRIMARY_USER_ID, real);
+            mSpManager.injectWeaverReadResponse(WeaverReadStatus.FAILED, Duration.ZERO);
+            assertTrue(mService.verifyCredential(candidate, PRIMARY_USER_ID, 0).isOtherError());
+            mSpManager.injectWeaverReadResponse(
+                    WeaverReadStatus.THROTTLE, Duration.ofSeconds(60));
+            assertTrue(mService.checkCredential(real, PRIMARY_USER_ID, null).hasTimeout());
+            verify(mInjector.mDuressPasswordHelper, never()).onCredentialRejected(any(), any());
+        }
+    }
+
+    @Test
+    public void duressManagementRequiresRealOwnerCredential() throws Exception {
+        mSpManager.enableWeaver();
+        try (var real = newPin("5962"); var candidate = newPin("2591");
+                var password = newPassword("test-duress-password"); var none = nonePassword()) {
+            setCredential(PRIMARY_USER_ID, real);
+            assertThrows(SecurityException.class,
+                    () -> mService.setDuressCredentials(none, candidate, password));
+            assertThrows(SecurityException.class,
+                    () -> mService.setDuressCredentials(candidate, none, none));
+            assertThrows(SecurityException.class, () -> mService.hasDuressCredentials(candidate));
+            verify(mInjector.mDuressPasswordHelper, never()).onCredentialRejected(any(), any());
+            verify(mInjector.mDuressPasswordHelper, never()).setDuressCredentials(any(), any());
+            verify(mInjector.mDuressPasswordHelper, never()).hasDuressCredentials();
+
+            mService.setDuressCredentials(real, candidate, password);
+            mService.setDuressCredentials(real, none, none);
+            verify(mInjector.mDuressPasswordHelper).setDuressCredentials(candidate, password);
+            verify(mInjector.mDuressPasswordHelper).setDuressCredentials(none, none);
+        }
+    }
+
+    @Test
+    public void duressStorageCannotBeAccessedThroughGenericBinderMethods() {
+        String key = DuressCredentials.LOCK_SETTINGS_STORAGE_KEY;
+        assertThrows(SecurityException.class, () -> mService.getString(key, null, PRIMARY_USER_ID));
+        assertThrows(SecurityException.class, () -> mService.setString(key, null, PRIMARY_USER_ID));
+        assertThrows(SecurityException.class, () -> mService.setBoolean(key, false, PRIMARY_USER_ID));
+        assertThrows(SecurityException.class, () -> mService.setLong(key, 0, PRIMARY_USER_ID));
+    }
+
