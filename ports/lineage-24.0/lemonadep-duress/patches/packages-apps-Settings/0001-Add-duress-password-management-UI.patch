+package com.android.settings.security;
+
+import static com.android.internal.widget.PasswordValidationError.CONTAINS_INVALID_CHARACTERS;
+import static com.android.internal.widget.PasswordValidationError.TOO_LONG;
+import static com.android.internal.widget.PasswordValidationError.TOO_SHORT;
+import static com.android.internal.widget.PasswordValidationError.TOO_SHORT_WHEN_ALL_NUMERIC;
+
+import android.app.AlertDialog;
+import android.os.Bundle;
+import android.text.TextUtils;
+import android.util.Log;
+import android.view.KeyEvent;
+import android.view.inputmethod.EditorInfo;
+import android.widget.EditText;
+import android.widget.TextView;
+import android.widget.Toast;
+
+import androidx.annotation.IdRes;
+import androidx.annotation.Nullable;
+import androidx.annotation.StringRes;
+
+import com.android.internal.widget.LockPatternUtils;
+import com.android.internal.widget.LockscreenCredential;
+import com.android.internal.widget.PasswordValidationError;
+import com.android.settings.R;
+import com.android.settingslib.utils.StringUtil;
+import com.google.android.setupcompat.template.FooterBarMixin;
+import com.google.android.setupcompat.template.FooterButton;
+import com.google.android.setupdesign.GlifLayout;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.function.Function;
+
+public class DuressPasswordSetupActivity extends DuressPasswordActivity
+        implements TextView.OnEditorActionListener {
+    private static final String TAG = "DuressPasswordSetup";
+    static final String EXTRA_USER_CREDENTIAL = "user_credential";
+    static final String EXTRA_IS_UPDATE = "is_update";
+
+    private LockscreenCredential mUserCredential;
+    private boolean mIsUpdate;
+
+    private enum DuressCredentialType {
+        PIN(LockscreenCredential::createPin, R.id.pin_input, R.id.pin_input_confirmation,
+                R.string.lockpassword_confirm_pins_dont_match),
+        PASSWORD(LockscreenCredential::createPassword, R.id.password_input,
+                R.id.password_input_confirmation, R.string.lockpassword_confirm_passwords_dont_match);
+
+        final Function<CharSequence, LockscreenCredential> credentialCreator;
+        final @IdRes int mainInputId;
+        final @IdRes int confirmationInputId;
+        final @StringRes int confirmationMismatchText;
+
+        DuressCredentialType(Function<CharSequence, LockscreenCredential> credentialCreator,
+                int mainInputId, int confirmationInputId, int confirmationMismatchText) {
+            this.credentialCreator = credentialCreator;
+            this.mainInputId = mainInputId;
+            this.confirmationInputId = confirmationInputId;
+            this.confirmationMismatchText = confirmationMismatchText;
+        }
+    }
+
+    @Override
+    protected void onCreate(@Nullable Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        mUserCredential = getIntent().getParcelableExtra(EXTRA_USER_CREDENTIAL,
+                LockscreenCredential.class);
+        getIntent().removeExtra(EXTRA_USER_CREDENTIAL);
+        if (savedInstanceState != null || mUserCredential == null || mUserCredential.isNone()
+                || !canManageDuressCredentials(this)) {
+            finish();
+            return;
+        }
+        mIsUpdate = getIntent().getBooleanExtra(EXTRA_IS_UPDATE, false);
+        setContentView(R.layout.duress_password_setup);
+
+        GlifLayout layout = requireViewById(R.id.glif_layout);
+        layout.setHeaderText(mIsUpdate ? R.string.duress_pwd_action_update
+                : R.string.duress_pwd_action_add);
+        FooterBarMixin footerBar = layout.getMixin(FooterBarMixin.class);
+        footerBar.setPrimaryButton(new FooterButton.Builder(this)
+                .setText(mIsUpdate ? R.string.duress_pwd_update_button : R.string.duress_pwd_add_button)
+                .setButtonType(FooterButton.ButtonType.DONE)
+                .setListener(view -> save())
+                .setTheme(com.google.android.setupdesign.R.style.SudGlifButton_Primary)
+                .build());
+        footerBar.setSecondaryButton(new FooterButton.Builder(this)
+                .setText(R.string.duress_pwd_cancel_button)
+                .setButtonType(FooterButton.ButtonType.CANCEL)
+                .setListener(view -> finish())
+                .setTheme(com.google.android.setupdesign.R.style.SudGlifButton_Secondary)
+                .build());
+        for (DuressCredentialType type : DuressCredentialType.values()) {
+            for (int inputId : new int[] {type.mainInputId, type.confirmationInputId}) {
+                EditText input = requireViewById(inputId);
+                input.setTag(type);
+                input.setOnEditorActionListener(this);
+            }
+        }
+    }
+
+    @Override
+    protected boolean hasUserCredential() {
+        return mUserCredential != null;
+    }
+
+    @Override
+    public boolean onEditorAction(TextView view, int actionId, KeyEvent event) {
+        if (actionId != EditorInfo.IME_ACTION_NEXT && actionId != EditorInfo.IME_ACTION_DONE) {
+            return false;
+        }
+        DuressCredentialType type = (DuressCredentialType) view.getTag();
+        return view.getId() == type.mainInputId
+                ? !checkCredentialInput(type) : !checkCredentialConfirmation(type);
+    }
+
+    private void save() {
+        boolean valid = true;
+        for (DuressCredentialType type : DuressCredentialType.values()) {
+            valid &= checkCredentialInput(type);
+            valid &= checkCredentialConfirmation(type);
+        }
+        if (!valid) {
+            return;
+        }
+        if (mIsUpdate) {
+            saveCredentials();
+        } else {
+            new AlertDialog.Builder(this)
+                    .setTitle(R.string.duress_pwd_save_warning_title)
+                    .setMessage(R.string.duress_pwd_save_warning_text)
+                    .setNegativeButton(R.string.duress_pwd_cancel_button, null)
+                    .setPositiveButton(R.string.duress_pwd_proceed_button,
+                            (dialog, which) -> saveCredentials())
+                    .show();
+        }
+    }
+
+    private void saveCredentials() {
+        try (LockscreenCredential pin = createCredential(DuressCredentialType.PIN);
+                LockscreenCredential password = createCredential(DuressCredentialType.PASSWORD)) {
+            getLockPatternUtils(this).setDuressCredentials(mUserCredential, pin, password);
+        } catch (RuntimeException e) {
+            Log.e(TAG, "Unable to save duress credentials", e);
+            new AlertDialog.Builder(this)
+                    .setMessage(R.string.duress_pwd_save_error)
+                    .setNeutralButton(R.string.duress_pwd_error_dialog_dismiss, null)
+                    .show();
+            return;
+        }
+        Toast.makeText(this,
+                mIsUpdate ? R.string.duress_pwd_toast_updated : R.string.duress_pwd_toast_added,
+                Toast.LENGTH_LONG).show();
+        setResult(RESULT_OK);
+        finish();
+    }
+
+    private LockscreenCredential createCredential(DuressCredentialType type) {
+        EditText input = requireViewById(type.mainInputId);
+        return type.credentialCreator.apply(input.getText());
+    }
+
+    private boolean checkCredentialInput(DuressCredentialType type) {
+        EditText input = requireViewById(type.mainInputId);
+        try (LockscreenCredential credential = createCredential(type)) {
+            List<PasswordValidationError> errors = LockPatternUtils.validateDuressCredential(
+                    credential);
+            List<String> messages = new ArrayList<>(errors.size());
+            for (PasswordValidationError error : errors) {
+                messages.add(getValidationMessage(error, credential.isPassword()));
+            }
+            input.setError(errors.isEmpty() ? null : TextUtils.join("\n", messages));
+            return errors.isEmpty();
+        }
+    }
+
+    private String getValidationMessage(PasswordValidationError error, boolean isPassword) {
+        return switch (error.errorCode) {
+            case CONTAINS_INVALID_CHARACTERS -> getString(R.string.lockpassword_illegal_character);
+            case TOO_SHORT -> StringUtil.getIcuPluralsString(this, error.requirement,
+                    isPassword ? R.string.lockpassword_password_too_short
+                            : R.string.lockpassword_pin_too_short);
+            case TOO_SHORT_WHEN_ALL_NUMERIC -> StringUtil.getIcuPluralsString(this, error.requirement,
+                    R.string.lockpassword_password_too_short_all_numeric);
+            case TOO_LONG -> StringUtil.getIcuPluralsString(this, error.requirement + 1,
+                    isPassword ? R.string.lockpassword_password_too_long
+                            : R.string.lockpassword_pin_too_long);
+            default -> getString(R.string.duress_pwd_invalid_credential);
+        };
+    }
+
+    private boolean checkCredentialConfirmation(DuressCredentialType type) {
+        EditText input = requireViewById(type.mainInputId);
+        EditText confirmation = requireViewById(type.confirmationInputId);
+        boolean matches = TextUtils.equals(input.getText(), confirmation.getText());
+        confirmation.setError(matches ? null : getText(type.confirmationMismatchText));
+        return matches;
+    }
+
+    @Override
+    protected void onDestroy() {
+        if (mUserCredential != null) {
+            mUserCredential.close();
+            mUserCredential = null;
+        }
+        if (findViewById(R.id.glif_layout) != null) {
+            for (DuressCredentialType type : DuressCredentialType.values()) {
+                ((EditText) requireViewById(type.mainInputId)).getText().clear();
+                ((EditText) requireViewById(type.confirmationInputId)).getText().clear();
+            }
+        }
+        super.onDestroy();
+    }
+}
