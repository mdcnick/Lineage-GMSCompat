+package com.android.settings.security;
+
+import android.app.Activity;
+import android.content.Context;
+import android.os.Bundle;
+import android.os.UserHandle;
+import android.view.WindowManager;
+
+import androidx.annotation.Nullable;
+
+import com.android.internal.widget.LockPatternUtils;
+import com.android.settings.SetupWizardUtils;
+import com.android.settings.overlay.FeatureFactory;
+import com.google.android.setupdesign.util.ThemeHelper;
+
+public abstract class DuressPasswordActivity extends Activity {
+    private boolean mAllowNextOnStop;
+
+    @Override
+    protected void onCreate(@Nullable Bundle savedInstanceState) {
+        setTheme(SetupWizardUtils.getTheme(this, getIntent()));
+        ThemeHelper.trySetDynamicColor(this);
+        super.onCreate(savedInstanceState);
+        getWindow().addFlags(WindowManager.LayoutParams.FLAG_SECURE);
+    }
+
+    @Override
+    protected void onStop() {
+        super.onStop();
+        if (!isChangingConfigurations() && !isFinishing() && hasUserCredential()) {
+            if (!mAllowNextOnStop) {
+                finish();
+            }
+            mAllowNextOnStop = false;
+        }
+    }
+
+    protected abstract boolean hasUserCredential();
+
+    protected void allowNextOnStop(boolean allow) {
+        mAllowNextOnStop = allow;
+    }
+
+    public static boolean canManageDuressCredentials(Context context) {
+        return context.getUserId() == UserHandle.USER_SYSTEM
+                && getLockPatternUtils(context).isSecure(UserHandle.USER_SYSTEM);
+    }
+
+    static LockPatternUtils getLockPatternUtils(Context context) {
+        return FeatureFactory.getFeatureFactory()
+                .getSecurityFeatureProvider()
+                .getLockPatternUtils(context);
+    }
+}
diff --git a/src/com/android/settings/security/DuressPasswordMainActivity.java b/src/com/android/settings/security/DuressPasswordMainActivity.java
new file mode 100644
index 0000000000000000000000000000000000000000..6ce7d23df3d5a614cfade7acdd33b57ad68c7f4a
--- /dev/null
+++ b/src/com/android/settings/security/DuressPasswordMainActivity.java
@@ -0,0 +1,189 @@
+package com.android.settings.security;
+
+import android.app.AlertDialog;
+import android.content.Intent;
+import android.os.Bundle;
+import android.os.UserHandle;
+import android.util.Log;
+
+import androidx.annotation.DrawableRes;
+import androidx.annotation.Nullable;
+import androidx.annotation.StringRes;
+
+import com.android.internal.widget.LockscreenCredential;
+import com.android.settings.R;
+import com.android.settings.password.ChooseLockSettingsHelper;
+import com.google.android.setupdesign.GlifRecyclerLayout;
+import com.google.android.setupdesign.items.IItem;
+import com.google.android.setupdesign.items.Item;
+import com.google.android.setupdesign.items.ItemGroup;
+import com.google.android.setupdesign.items.RecyclerItemAdapter;
+
+public class DuressPasswordMainActivity extends DuressPasswordActivity
+        implements RecyclerItemAdapter.OnItemSelectedListener {
+    private static final String TAG = "DuressPasswordSettings";
+    private static final String KEY_AWAITING_CONFIRMATION = "awaiting_confirmation";
+    private static final int REQ_CODE_OBTAIN_USER_CREDENTIALS = 1;
+    private static final int REQ_CODE_SETUP = 2;
+
+    private GlifRecyclerLayout mLayout;
+    private LockscreenCredential mUserCredential;
+    private boolean mAwaitingConfirmation;
+
+    @Override
+    protected void onCreate(@Nullable Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        if (!canManageDuressCredentials(this)) {
+            finish();
+            return;
+        }
+
+        mLayout = new GlifRecyclerLayout(this);
+        mLayout.setIcon(getDrawable(R.drawable.ic_lock));
+        mLayout.setHeaderText(R.string.duress_pwd_pref_title);
+        mLayout.setDescriptionText(R.string.duress_pwd_description);
+        setContentView(mLayout);
+
+        if (savedInstanceState != null) {
+            mAwaitingConfirmation = savedInstanceState.getBoolean(KEY_AWAITING_CONFIRMATION);
+        }
+    }
+
+    @Override
+    protected boolean hasUserCredential() {
+        return mUserCredential != null;
+    }
+
+    @Override
+    protected void onSaveInstanceState(Bundle outState) {
+        super.onSaveInstanceState(outState);
+        outState.putBoolean(KEY_AWAITING_CONFIRMATION, mAwaitingConfirmation);
+    }
+
+    @Override
+    protected void onResume() {
+        super.onResume();
+        if (isFinishing()) {
+            return;
+        }
+        if (!canManageDuressCredentials(this)) {
+            finish();
+            return;
+        }
+        if (hasUserCredential()) {
+            refreshActionList();
+        } else if (!mAwaitingConfirmation) {
+            mAwaitingConfirmation = new ChooseLockSettingsHelper.Builder(this)
+                    .setRequestCode(REQ_CODE_OBTAIN_USER_CREDENTIALS)
+                    .setUserId(UserHandle.USER_SYSTEM)
+                    .setReturnCredentials(true)
+                    .setForegroundOnly(true)
+                    .show();
+            if (!mAwaitingConfirmation) {
+                finish();
+            }
+        }
+    }
+
+    private void refreshActionList() {
+        ItemGroup group = new ItemGroup();
+        try {
+            if (getLockPatternUtils(this).hasDuressCredentials(mUserCredential)) {
+                group.addChild(createItem(R.string.duress_pwd_action_update, R.drawable.ic_edit));
+                group.addChild(createItem(R.string.duress_pwd_action_delete, R.drawable.ic_delete));
+            } else {
+                group.addChild(createItem(R.string.duress_pwd_action_add, R.drawable.ic_add_24dp));
+            }
+        } catch (RuntimeException e) {
+            Log.e(TAG, "Unable to query duress credentials", e);
+            mLayout.setAdapter(new RecyclerItemAdapter(group));
+            new AlertDialog.Builder(this)
+                    .setMessage(R.string.duress_pwd_query_error)
+                    .setNeutralButton(R.string.duress_pwd_error_dialog_dismiss,
+                            (dialog, which) -> finish())
+                    .setOnCancelListener(dialog -> finish())
+                    .show();
+            return;
+        }
+        RecyclerItemAdapter adapter = new RecyclerItemAdapter(group);
+        adapter.setOnItemSelectedListener(this);
+        mLayout.setAdapter(adapter);
+    }
+
+    private Item createItem(@StringRes int title, @DrawableRes int icon) {
+        Item item = new Item();
+        item.setId(title);
+        item.setTitle(getText(title));
+        item.setIcon(getDrawable(icon));
+        return item;
+    }
+
+    @Override
+    public void onItemSelected(IItem item) {
+        if (!hasUserCredential()) {
+            return;
+        }
+        int id = ((Item) item).getId();
+        if (id == R.string.duress_pwd_action_add || id == R.string.duress_pwd_action_update) {
+            Intent intent = new Intent(this, DuressPasswordSetupActivity.class)
+                    .putExtra(DuressPasswordSetupActivity.EXTRA_IS_UPDATE,
+                            id == R.string.duress_pwd_action_update)
+                    .putExtra(DuressPasswordSetupActivity.EXTRA_USER_CREDENTIAL, mUserCredential);
+            allowNextOnStop(true);
+            startActivityForResult(intent, REQ_CODE_SETUP);
+        } else if (id == R.string.duress_pwd_action_delete) {
+            new AlertDialog.Builder(this)
+                    .setMessage(R.string.duress_pwd_action_delete_confirmation)
+                    .setPositiveButton(R.string.duress_pwd_delete_button,
+                            (dialog, which) -> deleteDuressCredentials())
+                    .setNegativeButton(R.string.duress_pwd_cancel_button, null)
+                    .show();
+        }
+    }
+
+    private void deleteDuressCredentials() {
+        try {
+            getLockPatternUtils(this).deleteDuressCredentials(mUserCredential);
+        } catch (RuntimeException e) {
+            Log.e(TAG, "Unable to delete duress credentials", e);
+            new AlertDialog.Builder(this)
+                    .setMessage(R.string.duress_pwd_delete_error)
+                    .setNeutralButton(R.string.duress_pwd_error_dialog_dismiss, null)
+                    .show();
+            return;
+        }
+        refreshActionList();
+    }
+
+    @Override
+    protected void onActivityResult(int requestCode, int resultCode, @Nullable Intent data) {
+        super.onActivityResult(requestCode, resultCode, data);
+        if (requestCode == REQ_CODE_SETUP) {
+            allowNextOnStop(false);
+            if (resultCode != RESULT_OK) {
+                finish();
+            }
+        } else if (requestCode == REQ_CODE_OBTAIN_USER_CREDENTIALS) {
+            mAwaitingConfirmation = false;
+            if (resultCode != RESULT_OK || data == null) {
+                finish();
+                return;
+            }
+            mUserCredential = data.getParcelableExtra(ChooseLockSettingsHelper.EXTRA_KEY_PASSWORD,
+                    LockscreenCredential.class);
+            data.removeExtra(ChooseLockSettingsHelper.EXTRA_KEY_PASSWORD);
+            if (mUserCredential == null || mUserCredential.isNone()) {
+                finish();
+            }
+        }
+    }
+
+    @Override
+    protected void onDestroy() {
+        if (mUserCredential != null) {
+            mUserCredential.close();
+            mUserCredential = null;
+        }
+        super.onDestroy();
+    }
+}
